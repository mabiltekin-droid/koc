{
  "name": "opencode-question-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start:backend": "npm --prefix backend run dev",
    "start:frontend": "npm --prefix frontend run start",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\""
  },
  "dependencies": {
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "concurrently": "^7.0.0"
  }
}
