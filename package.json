{
  "name": "opencode-question-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start:backend": "npm --prefix backend run dev",
    "start:frontend": "npm --prefix frontend run start",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\""
  },
  "devDependencies": {
    "@vercel/node": "^5.7.15",
    "@vercel/static-build": "^2.9.22",
    "concurrently": "^7.0.0"
  }
}
